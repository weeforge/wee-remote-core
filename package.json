{
  "name": "wee-remote-core",
  "version": "0.1.0",
  "description": "ของกลางของ Wee Remote — types, E2E, chat events, history pagination, guards (Wee IDE · wee-node · wee-relay)",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "bun": "./src/protocol.ts",
      "import": "./dist/protocol.js",
      "default": "./dist/protocol.js"
    },
    "./e2e": {
      "types": "./dist/e2e.d.ts",
      "bun": "./src/e2e.ts",
      "import": "./dist/e2e.js",
      "default": "./dist/e2e.js"
    },
    "./chat-events": {
      "types": "./dist/chat-events.d.ts",
      "bun": "./src/chat-events.ts",
      "import": "./dist/chat-events.js",
      "default": "./dist/chat-events.js"
    },
    "./history": {
      "types": "./dist/history.d.ts",
      "bun": "./src/history.ts",
      "import": "./dist/history.js",
      "default": "./dist/history.js"
    },
    "./guards": {
      "types": "./dist/guards.d.ts",
      "bun": "./src/guards.ts",
      "import": "./dist/guards.js",
      "default": "./dist/guards.js"
    },
    "./git": {
      "types": "./dist/git.d.ts",
      "bun": "./src/git.ts",
      "import": "./dist/git.js",
      "default": "./dist/git.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "tsc --noEmit && bun test && tsc -p tsconfig.build.json && git diff --exit-code -- dist"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.19"
  }
}
